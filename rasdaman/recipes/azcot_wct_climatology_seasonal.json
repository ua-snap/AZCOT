{
  "config": {
    "service_url": "https://localhost/rasdaman/ows",
    "tmp_directory": "/tmp/",
    "blocking": true,
    "mock": false,
    "automated": true,
    "track_files": false
  },
  "input": {
    "coverage_id": "azcot_wct_climatology_seasonal",
    "paths": [
      "/opt/rasdaman-storage/coverage_data/azcot/azcot_wct_climatology_seasonal.nc"
    ]
  },
  "recipe": {
    "name": "general_coverage",
    "options": {
      "wms_import": true,
      "import_order": "ascending",
      "tiling": "ALIGNED [0:*, 0:*] tile size 4194304",
      "coverage": {
        "crs": "EPSG/0/4326",
        "metadata": {
          "type": "xml",
          "global": {
            "Title": "AZCOT wind chill temperature climatology (seasonal)",
            "Summary": "Seasonal climatology of hourly ERA5 wind chill temperature, 1991-2020, Oct-Mar. NWS 2001 wind chill (Nelson et al. 2002) from ERA5 2 m temperature and 10 m wind speed.",
            "Units": "{\"wct_min\": \"degF\", \"wct_mean\": \"degF\", \"wct_max\": \"degF\"}",
            "Encoding": "{}",
            "Source": "AZCOT curated coverages (SNAP, UAF), preprocess/ in the AZCOT repo; ERA5 1991-2020 Oct-Mar, Feb 29 excluded"
          }
        },
        "slicer": {
          "type": "netcdf",
          "pixelIsPoint": true,
          "bands": [
            {
              "name": "wct_min",
              "identifier": "wct_min",
              "nilValue": "nan"
            },
            {
              "name": "wct_mean",
              "identifier": "wct_mean",
              "nilValue": "nan"
            },
            {
              "name": "wct_max",
              "identifier": "wct_max",
              "nilValue": "nan"
            }
          ],
          "axes": {
            "lat": {
              "min": "${netcdf:variable:lat:min}",
              "max": "${netcdf:variable:lat:max}",
              "resolution": "${netcdf:variable:lat:resolution}",
              "gridOrder": 0
            },
            "lon": {
              "min": "${netcdf:variable:lon:min}",
              "max": "${netcdf:variable:lon:max}",
              "resolution": "${netcdf:variable:lon:resolution}",
              "gridOrder": 1
            }
          }
        }
      }
    }
  }
}
